@import "./business-ui.wxss";

page {
  --wine: #6d2434;
  --ink: #302927;
  --muted: #6d605b;
  --paper: #f9f5ed;
  --line: #e4d8cc;
  background: var(--paper);
  color: var(--ink);
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", "Microsoft YaHei", sans-serif;
  font-size: 28rpx;
  line-height: 1.55;
}
.screen { padding: 24rpx 30rpx 42rpx; }
.hero { margin-bottom: 22rpx; padding: 16rpx 2rpx 12rpx; color: #685b55; font-size: 26rpx; }
.hero > text { display: block; color: #762f40; font-size: 24rpx; font-weight: 600; }
.title {
  margin: 5rpx 0 8rpx;
  color: #342725;
  font-family: "Songti SC", "STSong", "SimSun", serif;
  font-weight: 700;
  font-size: 49rpx;
  line-height: 1.27;
  overflow-wrap: anywhere;
}
.panel { display: block; box-sizing: border-box; margin-bottom: 20rpx; padding: 25rpx; background: #fffdf9; border: 1rpx solid var(--line); border-radius: 24rpx; }
.heading { color: #372a28; font-size: 34rpx; line-height: 1.4; font-weight: 700; margin-bottom: 15rpx; }
.subheading { margin: 22rpx 0 10rpx; font-weight: 650; }
.line { display: flex; justify-content: space-between; align-items: flex-start; gap: 12rpx; }
.line > .strong, .line > view { min-width: 0; }
.strong { font-weight: 650; overflow-wrap: anywhere; }
.muted { color: var(--muted); font-size: 25rpx; overflow-wrap: anywhere; }
.profile-contact { display: flex; flex-wrap: wrap; gap: 12rpx 46rpx; }
.account-summary .heading { margin-bottom: 3rpx; overflow-wrap: anywhere; }
.edit-name, .login-screen .secondary { margin-top: 12rpx; }
.notice, .empty { border-radius: 16rpx; padding: 18rpx 20rpx; overflow-wrap: anywhere; }
.notice { margin-bottom: 16rpx; color: #683444; background: #f6e9e7; border: 1rpx solid #e5c8c7; }
.empty { color: #6b5c57; background: #faf7f0; border: 1rpx dashed #d4c6b4; text-align: center; }
.metrics { display: flex; flex-wrap: wrap; gap: 12rpx; }
.metric { box-sizing: border-box; flex: 1 1 150rpx; background: #fcf8f2; border: 1rpx solid #e5dbcd; border-radius: 16rpx; padding: 16rpx; }
.count { color: #612637; font-size: 44rpx; font-weight: 700; font-variant-numeric: tabular-nums; line-height: 1.3; }
.count text { color: #6b5f57; font-weight: 400; font-size: 23rpx; }
.chips { display: flex; flex-wrap: wrap; gap: 10rpx; margin-top: 14rpx; }
button { margin: 0; }
button::after { border: none; }
.chip, .secondary, .primary {
  box-sizing: border-box;
  min-height: 84rpx;
  padding: 16rpx 23rpx;
  font-size: 27rpx;
  line-height: 1.65;
  font-weight: 550;
  border-radius: 16rpx;
  border: 1rpx solid #dccbc1;
  color: #662a38;
  background: #fffaf5;
}
.chip { border-radius: 30rpx; padding-left: 20rpx; padding-right: 20rpx; }
.selected { color: #602434; background: #f5e6e6; border-color: #b48087; font-weight: 700; }
.primary { color: #fffaf4; background: var(--wine); border-color: var(--wine); font-weight: 700; margin-top: 18rpx; }
button[disabled] { color: #827870; background: #f3efe8; border-color: #e3dbd2; }
.record { display: block; box-sizing: border-box; width: 100%; margin: 10rpx 0; padding: 19rpx; color: #342c2a; text-align: left; background: #fffdfa; border: 1rpx solid #e6dcd0; border-radius: 17rpx; }
.lead-button { line-height: 1.55; }
.progress-link, .progress-button { color: #722b3e; font-size: 26rpx; font-weight: 600; }
.progress-button { min-height: 80rpx; margin-top: 8rpx; padding: 16rpx 18rpx; text-align: left; border-radius: 13rpx; line-height: 1.65; background: #f8ecea; }
.tag { flex: none; max-width: 52%; box-sizing: border-box; border-radius: 9rpx; padding: 3rpx 10rpx; color: #663643; background: #f4e7e7; font-size: 23rpx; line-height: 1.5; white-space: normal; overflow-wrap: anywhere; }
label, .label { display: block; color: #63554f; margin: 13rpx 0 6rpx; font-size: 26rpx; }
input, .input { width: 100%; min-height: 84rpx; box-sizing: border-box; border: 1rpx solid #d9cdc1; border-radius: 13rpx; padding: 12rpx 18rpx; margin: 7rpx 0 13rpx; background: #fcfaf6; color: #332925; font-size: 28rpx; line-height: 1.55; }
input.invalid-input { border-color: #a03836; }
.field-error { color: #a03836; font-size: 25rpx; margin: 4rpx 0 12rpx; }
.consent { margin: 18rpx 0; }
.board-periods { margin: 0 0 14rpx; }
.board-dates { display: flex; gap: 12rpx; }
.board-dates > view { flex: 1; min-width: 0; }
.board-dates .input { font-size: 25rpx; }
.board-note { margin: 15rpx 0; }
.board-card { text-align: left; line-height: 1.55; flex-basis: 42%; }
.board-card.selected { border-color: #b8838e; background: #f6e8e8; }
.board-pager { display: flex; align-items: center; justify-content: space-between; gap: 8rpx; margin-top: 19rpx; }
.board-page-size { text-align: center; margin-top: 8rpx; }
