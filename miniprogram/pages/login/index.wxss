.login-cover {
  position: relative;
  overflow: hidden;
  box-sizing: border-box;
  padding: 34rpx 38rpx 32rpx;
  margin: 12rpx 0 24rpx;
  background: var(--wine);
  border-radius: 7rpx 25rpx 25rpx 7rpx;
  border-left: 9rpx solid #55232e;
  box-shadow: 0 5rpx 0 #e6d5bd;
}
.login-kicker { color: #efddc7; font-size: 25rpx; letter-spacing: 2rpx; }
.login-title { margin-top: 5rpx; color: #fff8ed; font: 700 58rpx/1.3 "Songti SC", "STSong", "SimSun", serif; }
.login-bookmark { position: absolute; top: 0; right: 36rpx; width: 21rpx; height: 35rpx; background: #ccab78; }
.login-bookmark::after { content: ""; position: absolute; bottom: 0; border-left: 11rpx solid transparent; border-right: 11rpx solid transparent; border-bottom: 8rpx solid var(--wine); }
.login-screen .panel { padding: 32rpx; }
.login-actions { display: flex; justify-content: space-between; gap: 12rpx; margin-top: 8rpx; }
.login-link { min-height: 88rpx; color: var(--wine); background: transparent; padding: 18rpx 4rpx; font-size: 26rpx; line-height: 1.8; }
