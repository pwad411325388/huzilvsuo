.case-cover { box-sizing: border-box; padding: 26rpx; border: 1rpx solid #e3cdc6; border-radius: 24rpx; background: #f5e9e4; line-height: 1.65; }
.case-cover .title { color: #582335; margin: 7rpx 0 12rpx; }
.case-progress .heading { padding-bottom: 16rpx; border-bottom: 1rpx solid #e7dcd1; margin-bottom: 18rpx; }
.step-list { padding: 6rpx 0; }
.step-row { position: relative; display: flex; align-items: flex-start; padding-bottom: 32rpx; }
.step-row:last-child { padding-bottom: 0; }
.step-mark { position: relative; z-index: 1; flex: none; display: flex; align-items: center; justify-content: center; box-sizing: border-box; width: 32rpx; height: 32rpx; margin-top: 20rpx; border: 3rpx solid #acb5bf; border-radius: 50%; background: #fff; }
.step-connector { position: absolute; top: 36rpx; bottom: -36rpx; left: 15rpx; width: 2rpx; background: #c5cdd4; }
.step-content { flex: 1; min-width: 0; margin-left: 20rpx; }
.step-label { color: #626d79; font-size: 56rpx; font-weight: 600; line-height: 72rpx; overflow-wrap: anywhere; }
.step-line { display: flex; align-items: baseline; flex-wrap: wrap; gap: 2rpx 20rpx; }
.step-status { min-width: 0; flex: 1 1 120rpx; color: #576674; font-size: 26rpx; line-height: 1.5; overflow-wrap: anywhere; word-break: break-all; }
.step-date { margin-top: 4rpx; color: #606e79; font-size: 24rpx; line-height: 1.5; }
.step-current .step-mark { color: #fff; background: #18794e; border-color: #18794e; font-size: 24rpx; font-weight: 700; line-height: 1; }
.step-current .step-label { color: #18794e; }
.step-active .step-mark { background: #d4a21f; border-color: #876513; }
.step-active .step-label { color: #d4a21f; }
.step-uncertain .step-mark { color: #52606b; background: #eef0f2; border-color: #9aa5af; }
.step-uncertain .step-label { color: #566370; }
.progress-notice { margin: 12rpx 0 0 52rpx; font-size: 25rpx; line-height: 1.6; }
.contract { margin-top: 10rpx; padding: 7rpx 12rpx; color: #68404a; background: #f7efeb; border-radius: 8rpx; font-size: 25rpx; overflow-wrap: anywhere; word-break: break-all; }
